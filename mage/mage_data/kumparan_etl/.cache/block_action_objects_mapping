{"block_file": {"custom/backfill_chunk_insert.py:custom:python:backfill chunk insert": {"content": "if 'custom' not in globals():\n    from mage_ai.data_preparation.decorators import custom\nif 'test' not in globals():\n    from mage_ai.data_preparation.decorators import test\n\n\n@custom\ndef transform_custom(*args, **kwargs):\n    \"\"\"\n    args: The output from any upstream parent blocks (if applicable)\n\n    Returns:\n        Anything (e.g. data frame, dictionary, array, int, str, etc.)\n    \"\"\"\n    # Specify your custom logic here\n\n    return {}\n\n\n@test\ndef test_output(output, *args) -> None:\n    \"\"\"\n    Template code for testing the output of the block.\n    \"\"\"\n    assert output is not None, 'The output is undefined'\n", "file_path": "custom/backfill_chunk_insert.py", "language": "python", "type": "custom", "uuid": "backfill_chunk_insert"}, "data_exporters/backfill_chunk_insert.py:data_exporter:python:backfill chunk insert": {"content": "# Block: backfill_chunks | Type: Data exporter (Python, Generic)\n# Tugas: memuat data historis per bulan created_at, satu chunk satu partisi ClickHouse.\n# Setiap chunk yang selesai dicatat di etl_backfill_checkpoint, sehingga kalau terhenti\n# di tengah jalan, run berikutnya melanjutkan dari chunk yang belum selesai.\n# Menjalankan ulang satu chunk aman (idempoten) karena ReplacingMergeTree.\nimport time\nfrom os import path\n\nimport pandas as pd\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.articles import insert_articles, prepare_articles_df\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nPIPELINE = 'articles_backfill'\n\n\n@data_exporter\ndef backfill_chunks(plan, *args, **kwargs):\n    if isinstance(plan, list) and plan:\n        plan = plan[0]\n    chunks = plan['chunks']\n    if not chunks:\n        print('Tidak ada chunk yang perlu diproses')\n        return\n\n    client = get_clickhouse_client()\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    total_rows = 0\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        for chunk in chunks:\n            period = pd.Period(chunk, freq='M')\n            start = period.start_time.strftime('%Y-%m-%d %H:%M:%S')\n            end = (period + 1).start_time.strftime('%Y-%m-%d %H:%M:%S')\n            df = loader.load(f\"\"\"\n                SELECT id, title, content, published_at, author_id,\n                       created_at, updated_at, deleted_at\n                FROM public.articles\n                WHERE created_at >= '{start}+00'::timestamptz\n                  AND created_at <  '{end}+00'::timestamptz\n                ORDER BY id\n            \"\"\")\n\n            rows = 0\n            if not df.empty:\n                insert_articles(client, prepare_articles_df(df), int(time.time() * 1000))\n                rows = len(df)\n\n            # Checkpoint ditulis SETELAH data chunk berhasil masuk\n            client.insert('etl_backfill_checkpoint', [[PIPELINE, chunk, rows]],\n                          column_names=['pipeline', 'chunk', 'rows_written'])\n            total_rows += rows\n            print(f'Chunk {chunk}: {rows} baris')\n\n    print(f'Selesai: {len(chunks)} chunk, {total_rows} baris')\n", "file_path": "data_exporters/backfill_chunk_insert.py", "language": "python", "type": "data_exporter", "uuid": "backfill_chunk_insert"}, "data_exporters/update_watermark.py:data_exporter:python:update watermark": {"content": "# update watermark yang akan digunakan untuk siklus update data berikutnya\n\nimport pandas as pd\n\nfrom kumparan_etl.utils.warehouse import PIPELINE_NAME, get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\n\n@data_exporter\ndef update_watermark(*upstream_outputs, **kwargs):\n    # Urutan argumen mengikuti urutan upstream, jadi ambil saja DataFrame-nya\n    frames = [o for o in upstream_outputs if isinstance(o, pd.DataFrame)]\n    if not frames or frames[0].empty:\n        print('Tidak ada data baru, watermark tetap')\n        return\n\n    df = frames[0]\n    latest = df.sort_values(['updated_at', 'id']).iloc[-1]\n\n    client = get_clickhouse_client()\n    client.insert(\n        'etl_state',\n        [[\n            PIPELINE_NAME,\n            latest['updated_at'].to_pydatetime(),\n            int(latest['id']),\n            len(df),\n        ]],\n        column_names=['pipeline', 'last_updated_at', 'last_id', 'rows_synced'],\n    )\n    print(f\"Watermark digeser ke {latest['updated_at']} (id {int(latest['id'])})\")\n", "file_path": "data_exporters/update_watermark.py", "language": "python", "type": "data_exporter", "uuid": "update_watermark"}, "data_exporters/update_data_delete.py:data_exporter:python:update data delete": {"content": "# menandai data terdelete di data warehouse\n\nimport time\n\nimport pandas as pd\n\nfrom kumparan_etl.utils.articles import insert_articles, prepare_articles_df\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nPIPELINE = 'data_delete_handler'\nLOOKUP_BATCH = 10_000\n\nLOOKUP_SQL = \"\"\"\n    SELECT id, title, content, published_at, author_id, created_at, updated_at, deleted_at\n    FROM articles FINAL\n    WHERE id IN {ids:Array(UInt64)} AND _is_hard_deleted = 0\n\"\"\"\n\n\n@data_exporter\ndef apply_hard_deletes(*upstream_outputs, **kwargs):\n    frames = [o for o in upstream_outputs if isinstance(o, pd.DataFrame)]\n    if not frames or frames[0].empty:\n        print('Tidak ada hard delete baru')\n        return\n    tombstones = frames[0]\n\n    client = get_clickhouse_client()\n    ids = sorted({int(x) for x in tombstones['article_id']})\n\n    # Versi terakhir artikel di warehouse, yang belum ditandai terhapus\n    found = []\n    for i in range(0, len(ids), LOOKUP_BATCH):\n        found.append(client.query_df(LOOKUP_SQL, parameters={'ids': ids[i:i + LOOKUP_BATCH]}))\n    existing = pd.concat(found, ignore_index=True) if found else pd.DataFrame()\n\n    written = 0\n    if not existing.empty:\n        version = int(time.time() * 1000)\n        insert_articles(client, prepare_articles_df(existing), version, is_hard_deleted=1)\n        written = len(existing)\n\n    # Artikel yang terhapus sebelum pernah tersinkron (atau sudah ditandai) tidak punya baris\n    # untuk ditandai, tetapi event-nya tetap dianggap selesai.\n    last = tombstones.iloc[-1]\n    client.insert(\n        'etl_state',\n        [[PIPELINE, pd.Timestamp(last['deleted_at']).to_pydatetime(), int(last['event_id']), written]],\n        column_names=['pipeline', 'last_updated_at', 'last_id', 'rows_synced'],\n    )\n    print(f'{written} artikel ditandai hard delete, state digeser ke event_id {int(last[\"event_id\"])}')\n", "file_path": "data_exporters/update_data_delete.py", "language": "python", "type": "data_exporter", "uuid": "update_data_delete"}, "data_exporters/transfer_watermark.py:data_exporter:python:transfer watermark": {"content": "# Block: handover_watermark | Type: Data exporter (Python, Generic)\n# Tugas: menyerahkan tongkat ke pipeline incremental. Watermark articles_incremental disetel ke t0\n# (waktu SEBELUM backfill mulai, bukan waktu selesai), supaya perubahan selama backfill\n# tidak hilang. Baris yang terbaca dua kali aman karena pipeline idempoten.\n# Watermark tidak dimundurkan kalau incremental sudah lebih maju.\nfrom os import path\n\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\nif \"data_exporter\" not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nBACKFILL = \"data_backfill\"\nINCREMENTAL = \"articles_incremental\"\nSTATE_SQL = \"SELECT last_updated_at FROM etl_state FINAL WHERE pipeline = {p:String}\"\n\n\n@data_exporter\ndef handover_watermark(*args, **kwargs):\n    client = get_clickhouse_client()\n\n    backfill_state = client.query(STATE_SQL, parameters={\"p\": BACKFILL})\n    if backfill_state.row_count == 0:\n        print(\"Backfill belum pernah dimulai, tidak ada yang diserahkan\")\n        return\n    t0 = backfill_state.first_row[0]\n\n    incremental_state = client.query(STATE_SQL, parameters={\"p\": INCREMENTAL})\n    if incremental_state.row_count == 0 or incremental_state.first_row[0] < t0:\n        client.insert(\n            \"etl_state\",\n            [[INCREMENTAL, t0, 0, 0]],\n            column_names=[\"pipeline\", \"last_updated_at\", \"last_id\", \"rows_synced\"],\n        )\n        print(f\"Watermark {INCREMENTAL} disetel ke t0 = {t0.isoformat()}\")\n    else:\n        print(f\"Watermark {INCREMENTAL} sudah lebih maju dari t0, dibiarkan\")\n\n    # Validasi sederhana: jumlah baris dengan created_at <= t0 di kedua sisi\n    config_path = path.join(get_repo_path(), \"io_config.yaml\")\n    with Postgres.with_config(ConfigFileLoader(config_path, \"default\")) as loader:\n        pg_count = int(\n            loader.load(\n                f\"SELECT count(*) AS n FROM public.articles WHERE created_at <= '{t0.isoformat()}'::timestamptz\"\n            )[\"n\"].iloc[0]\n        )\n    ch_count = client.query(\n        \"SELECT count() FROM articles FINAL WHERE created_at <= {t0:DateTime64(3)} AND _is_hard_deleted = 0\",\n        parameters={\"t0\": t0},\n    ).first_row[0]\n    status = \"COCOK\" if pg_count == ch_count else \"SELISIH, periksa\"\n    print(f\"Validasi: Postgres={pg_count}, ClickHouse={ch_count} -> {status}\")\n", "file_path": "data_exporters/transfer_watermark.py", "language": "python", "type": "data_exporter", "uuid": "transfer_watermark"}, "data_exporters/reset_clickhouse.py:data_exporter:python:reset clickhouse": {"content": "# menghapus data yang sudah tersimpan di clickhouse \nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nTABLES = ['articles', 'etl_state', 'etl_backfill_checkpoint']\n\n\n@data_exporter\ndef reset_clickhouse(*args, **kwargs):\n    client = get_clickhouse_client()\n    for table in TABLES:\n        client.command(f'TRUNCATE TABLE {table}')\n\n    for table in TABLES:\n        remaining = client.query(f'SELECT count() FROM {table}').first_row[0]\n        print(f'ClickHouse dwh.{table}: {remaining} baris')", "file_path": "data_exporters/reset_clickhouse.py", "language": "python", "type": "data_exporter", "uuid": "reset_clickhouse"}, "data_exporters/insert_backfill.py:data_exporter:python:insert backfill": {"content": "# mengisi chunk dengan data historis per bulan lalu diinsert secara partisi ke clickhouse\n\nimport time\nfrom os import path\n\nimport pandas as pd\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.articles import insert_articles, prepare_articles_df\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nPIPELINE = 'data_backfill'\n\n\n@data_exporter\ndef insert_backfill(plan, *args, **kwargs):\n    if isinstance(plan, list) and plan:\n        plan = plan[0]\n    chunks = plan['chunks']\n    if not chunks:\n        print('Tidak ada chunk yang perlu diproses')\n        return\n\n    client = get_clickhouse_client()\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    total_rows = 0\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        for chunk in chunks:\n            period = pd.Period(chunk, freq='M')\n            start = period.start_time.strftime('%Y-%m-%d %H:%M:%S')\n            end = (period + 1).start_time.strftime('%Y-%m-%d %H:%M:%S')\n            df = loader.load(f\"\"\"\n                SELECT id, title, content, published_at, author_id,\n                       created_at, updated_at, deleted_at\n                FROM public.articles\n                WHERE created_at >= '{start}+00'::timestamptz\n                  AND created_at <  '{end}+00'::timestamptz\n                ORDER BY id\n            \"\"\")\n\n            rows = 0\n            if not df.empty:\n                insert_articles(client, prepare_articles_df(df), int(time.time() * 1000))\n                rows = len(df)\n\n            # Checkpoint ditulis SETELAH data chunk berhasil masuk\n            client.insert('etl_backfill_checkpoint', [[PIPELINE, chunk, rows]],\n                          column_names=['pipeline', 'chunk', 'rows_written'])\n            total_rows += rows\n            print(f'Chunk {chunk}: {rows} baris')\n\n    print(f'Selesai: {len(chunks)} chunk, {total_rows} baris')\n", "file_path": "data_exporters/insert_backfill.py", "language": "python", "type": "data_exporter", "uuid": "insert_backfill"}, "data_exporters/reset_postgres.py:data_exporter:python:reset postgres": {"content": "# menghapus data seluruh table di postgres\n\nimport os\n\nimport psycopg2\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\n\n@data_exporter\ndef reset_postgres(*args, **kwargs):\n    conn = psycopg2.connect(\n        host=os.environ['POSTGRES_HOST'],\n        port=5432,   # port internal Docker, bukan port yang dipetakan ke komputer\n        dbname=os.environ['POSTGRES_DB'],\n        user=os.environ['POSTGRES_USER'],\n        password=os.environ['POSTGRES_PASSWORD'],\n    )\n    try:\n        with conn:   # commit otomatis jika sukses, rollback jika error\n            with conn.cursor() as cur:\n                cur.execute(\n                    'TRUNCATE TABLE public.articles, public.articles_hard_deleted RESTART IDENTITY'\n                )\n                cur.execute(\n                    'SELECT (SELECT count(*) FROM public.articles), '\n                    '(SELECT count(*) FROM public.articles_hard_deleted)'\n                )\n                articles, tombstones = cur.fetchone()\n    finally:\n        conn.close()\n\n    print(f'Postgres dikosongkan: articles={articles}, articles_hard_deleted={tombstones}')", "file_path": "data_exporters/reset_postgres.py", "language": "python", "type": "data_exporter", "uuid": "reset_postgres"}, "data_exporters/backfill_chunk_export.py:data_exporter:python:backfill chunk export": {"content": "# mengirim data historis dari database ke datawarehouse\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nBACKFILL = 'data_history_insert'\nINCREMENTAL = 'data_insert_hourly'\nSTATE_SQL = 'SELECT last_updated_at FROM etl_state FINAL WHERE pipeline = {p:String}'\n\n\n@data_exporter\ndef handover_watermark(*args, **kwargs):\n    client = get_clickhouse_client()\n\n    backfill_state = client.query(STATE_SQL, parameters={'p': BACKFILL})\n    if backfill_state.row_count == 0:\n        print('Backfill belum pernah dimulai, tidak ada yang diserahkan')\n        return\n    t0 = backfill_state.first_row[0]\n\n    incremental_state = client.query(STATE_SQL, parameters={'p': INCREMENTAL})\n    if incremental_state.row_count == 0 or incremental_state.first_row[0] < t0:\n        client.insert('etl_state', [[INCREMENTAL, t0, 0, 0]],\n                      column_names=['pipeline', 'last_updated_at', 'last_id', 'rows_synced'])\n        print(f'Watermark {INCREMENTAL} disetel ke t0 = {t0.isoformat()}')\n    else:\n        print(f'Watermark {INCREMENTAL} sudah lebih maju dari t0, dibiarkan')\n\n    # Validasi sederhana: jumlah baris dengan created_at <= t0 di kedua sisi\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        pg_count = int(loader.load(\n            f\"SELECT count(*) AS n FROM public.articles WHERE created_at <= '{t0.isoformat()}'::timestamptz\"\n        )['n'].iloc[0])\n    ch_count = client.query(\n        'SELECT count() FROM articles FINAL WHERE created_at <= {t0:DateTime64(3)} AND _is_hard_deleted = 0',\n        parameters={'t0': t0},\n    ).first_row[0]\n    status = 'COCOK' if pg_count == ch_count else 'SELISIH, periksa'\n    print(f'Validasi: Postgres={pg_count}, ClickHouse={ch_count} -> {status}')\n", "file_path": "data_exporters/backfill_chunk_export.py", "language": "python", "type": "data_exporter", "uuid": "backfill_chunk_export"}, "data_exporters/load_data.py:data_exporter:python:load data": {"content": "# load data ke data warehouse\n\nimport time\nfrom collections import defaultdict\n\nimport pandas as pd\n\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nCOLUMNS = [\n    'id', 'title', 'content', 'published_at', 'author_id',\n    'created_at', 'updated_at', 'deleted_at',\n    '_is_hard_deleted', '_version',\n]\n\n\ndef _dt(value):\n    \"\"\"NaT/None menjadi None (kolom Nullable), selain itu datetime Python.\"\"\"\n    return None if pd.isna(value) else value.to_pydatetime()\n\n\n@data_exporter\ndef load_articles(df, *args, **kwargs):\n    if df.empty:\n        print('Tidak ada perubahan, tidak ada yang ditulis')\n        return\n\n    version = int(time.time() * 1000)   # waktu sync (ms), versi yang lebih besar menang\n\n    # Kelompokkan baris per bulan created_at (UTC, sama dengan toYYYYMM di ClickHouse)\n    batches = defaultdict(list)\n    for r in df.itertuples(index=False):\n        batches[r.created_at.strftime('%Y%m')].append((\n            int(r.id), r.title, r.content, _dt(r.published_at), int(r.author_id),\n            _dt(r.created_at), _dt(r.updated_at), _dt(r.deleted_at),\n            0, version,\n        ))\n\n    client = get_clickhouse_client()\n    for month, rows in sorted(batches.items()):\n        client.insert('articles', rows, column_names=COLUMNS)\n\n    print(f'Ditulis {len(df)} baris ke ClickHouse dalam {len(batches)} partisi bulanan')\n", "file_path": "data_exporters/load_data.py", "language": "python", "type": "data_exporter", "uuid": "load_data"}, "data_loaders/update_simulation.sql:data_loader:sql:update simulation": {"content": "-- simulasi update data\n\nUPDATE public.articles\nSET content = 'Diedit pada ' || now()::text || '. ' || repeat('Lorem ipsum dolor sit amet. ', 10)\nWHERE id IN (\n    SELECT id FROM public.articles WHERE deleted_at IS NULL ORDER BY random() LIMIT 5\n);\n\n", "file_path": "data_loaders/update_simulation.sql", "language": "sql", "type": "data_loader", "uuid": "update_simulation"}, "data_loaders/delete_simulation.sql:data_loader:sql:delete simulation": {"content": "-- simulasi delete data\n\nDELETE FROM public.articles\nWHERE id IN (\n    SELECT id FROM public.articles ORDER BY random() LIMIT 1\n)\nRETURNING *;\n", "file_path": "data_loaders/delete_simulation.sql", "language": "sql", "type": "data_loader", "uuid": "delete_simulation"}, "data_loaders/backfill_chunks_scheme.py:data_loader:python:backfill chunks scheme": {"content": "# pengaturan backfill chunk, membuat chunk dengan berpatokan bulan, dan menentukan titik mulanya\n\nfrom os import path\n\nimport pandas as pd\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\nPIPELINE = 'data_history_insert'\n\n\ndef _utc_naive(value):\n    ts = pd.Timestamp(value)\n    return ts.tz_convert('UTC').tz_localize(None) if ts.tzinfo else ts\n\n\n@data_loader\ndef plan_backfill(*args, **kwargs):\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        bounds = loader.load('SELECT min(created_at) AS first_created, now() AS now_pg FROM public.articles')\n\n    first_created = bounds['first_created'].iloc[0]\n    if pd.isna(first_created):\n        print('Tabel articles kosong, tidak ada yang di-backfill')\n        return {'t0': None, 'chunks': [], 'total_chunks': 0}\n\n    client = get_clickhouse_client()\n    state = client.query(\n        'SELECT last_updated_at FROM etl_state FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE},\n    )\n    if state.row_count == 0:\n        t0 = pd.Timestamp(bounds['now_pg'].iloc[0]).to_pydatetime()\n        client.insert('etl_state', [[PIPELINE, t0, 0, 0]],\n                      column_names=['pipeline', 'last_updated_at', 'last_id', 'rows_synced'])\n        print(f't0 baru dikunci: {t0.isoformat()}')\n    else:\n        t0 = state.first_row[0]\n        print(f'Melanjutkan backfill, t0 lama dipakai: {t0.isoformat()}')\n\n    all_chunks = [str(p) for p in pd.period_range(\n        start=_utc_naive(first_created), end=_utc_naive(t0), freq='M')]\n\n    done = client.query(\n        'SELECT chunk FROM etl_backfill_checkpoint FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE},\n    )\n    done_chunks = {row[0] for row in done.result_rows}\n    pending = [c for c in all_chunks if c not in done_chunks]\n\n    print(f'{len(pending)} dari {len(all_chunks)} chunk belum diproses')\n    return {'t0': t0.isoformat(), 'chunks': pending, 'total_chunks': len(all_chunks)}\n", "file_path": "data_loaders/backfill_chunks_scheme.py", "language": "python", "type": "data_loader", "uuid": "backfill_chunks_scheme"}, "data_loaders/reeset_check.py:data_loader:python:reeset check": {"content": "# berfungsi mengecek apakah reset data diperbolehkan\n\nimport os\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\n\n@data_loader\ndef check_reset_allowed(*args, **kwargs):\n    if os.environ.get('ALLOW_RESET', 'true').strip().lower() == 'false':\n        raise PermissionError('Reset dinonaktifkan (ALLOW_RESET=false di .env).')\n    print('Reset diizinkan: Postgres dan ClickHouse akan dikosongkan.')\n    return {'allowed': True}", "file_path": "data_loaders/reeset_check.py", "language": "python", "type": "data_loader", "uuid": "reeset_check"}, "data_loaders/backfill_chunck_insert.py:data_loader:python:backfill chunck insert": {"content": "# Block: backfill_chunks | Type: Data exporter (Python, Generic)\n# Tugas: memuat data historis per bulan created_at, satu chunk satu partisi ClickHouse.\n# Setiap chunk yang selesai dicatat di etl_backfill_checkpoint, sehingga kalau terhenti\n# di tengah jalan, run berikutnya melanjutkan dari chunk yang belum selesai.\n# Menjalankan ulang satu chunk aman (idempoten) karena ReplacingMergeTree.\nimport time\nfrom os import path\n\nimport pandas as pd\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.articles import insert_articles, prepare_articles_df\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\nPIPELINE = 'data_history_insert'\n\n\n@data_exporter\ndef backfill_chunks(plan, *args, **kwargs):\n    if isinstance(plan, list) and plan:\n        plan = plan[0]\n    chunks = plan['chunks']\n    if not chunks:\n        print('Tidak ada chunk yang perlu diproses')\n        return\n\n    client = get_clickhouse_client()\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    total_rows = 0\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        for chunk in chunks:\n            period = pd.Period(chunk, freq='M')\n            start = period.start_time.strftime('%Y-%m-%d %H:%M:%S')\n            end = (period + 1).start_time.strftime('%Y-%m-%d %H:%M:%S')\n            df = loader.load(f\"\"\"\n                SELECT id, title, content, published_at, author_id,\n                       created_at, updated_at, deleted_at\n                FROM public.articles\n                WHERE created_at >= '{start}+00'::timestamptz\n                  AND created_at <  '{end}+00'::timestamptz\n                ORDER BY id\n            \"\"\")\n\n            rows = 0\n            if not df.empty:\n                insert_articles(client, prepare_articles_df(df), int(time.time() * 1000))\n                rows = len(df)\n\n            # Checkpoint ditulis SETELAH data chunk berhasil masuk\n            client.insert('etl_backfill_checkpoint', [[PIPELINE, chunk, rows]],\n                          column_names=['pipeline', 'chunk', 'rows_written'])\n            total_rows += rows\n            print(f'Chunk {chunk}: {rows} baris')\n\n    print(f'Selesai: {len(chunks)} chunk, {total_rows} baris')\n", "file_path": "data_loaders/backfill_chunck_insert.py", "language": "python", "type": "data_loader", "uuid": "backfill_chunck_insert"}, "data_loaders/backfill_plan.py:data_loader:python:backfill plan": {"content": "# inisiasi bulan sebagai chunk data\n\nfrom os import path\n\nimport pandas as pd\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\nPIPELINE = 'data_backfill'\n\n\ndef _utc_naive(value):\n    ts = pd.Timestamp(value)\n    return ts.tz_convert('UTC').tz_localize(None) if ts.tzinfo else ts\n\n\n@data_loader\ndef backfill_plan(*args, **kwargs):\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        bounds = loader.load('SELECT min(created_at) AS first_created, now() AS now_pg FROM public.articles')\n\n    first_created = bounds['first_created'].iloc[0]\n    if pd.isna(first_created):\n        print('Tabel articles kosong, tidak ada yang di-backfill')\n        return {'t0': None, 'chunks': [], 'total_chunks': 0}\n\n    client = get_clickhouse_client()\n    state = client.query(\n        'SELECT last_updated_at FROM etl_state FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE},\n    )\n    if state.row_count == 0:\n        t0 = pd.Timestamp(bounds['now_pg'].iloc[0]).to_pydatetime()\n        client.insert('etl_state', [[PIPELINE, t0, 0, 0]],\n                      column_names=['pipeline', 'last_updated_at', 'last_id', 'rows_synced'])\n        print(f't0 baru dikunci: {t0.isoformat()}')\n    else:\n        t0 = state.first_row[0]\n        print(f'Melanjutkan backfill, t0 lama dipakai: {t0.isoformat()}')\n\n    all_chunks = [str(p) for p in pd.period_range(\n        start=_utc_naive(first_created), end=_utc_naive(t0), freq='M')]\n\n    done = client.query(\n        'SELECT chunk FROM etl_backfill_checkpoint FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE},\n    )\n    done_chunks = {row[0] for row in done.result_rows}\n    pending = [c for c in all_chunks if c not in done_chunks]\n\n    print(f'{len(pending)} dari {len(all_chunks)} chunk belum diproses')\n    return {'t0': t0.isoformat(), 'chunks': pending, 'total_chunks': len(all_chunks)}\n", "file_path": "data_loaders/backfill_plan.py", "language": "python", "type": "data_loader", "uuid": "backfill_plan"}, "data_loaders/extract_data_delete.py:data_loader:python:extract data delete": {"content": "# mengambil informasi data terdelete\n\nfrom os import path\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\n# Mundur sedikit karena nomor event dari sequence bisa commit tidak berurutan.\n# Aman karena langkah berikutnya idempoten (baris yang sudah ditandai dilewati).\nEVENT_OVERLAP = 1000\n\n\n@data_loader\ndef extract_tombstones(watermark, *args, **kwargs):\n    start_event_id = max(int(watermark['last_event_id']) - EVENT_OVERLAP, 0)\n    query = f\"\"\"\n        SELECT event_id, article_id, deleted_at\n        FROM public.articles_hard_deleted\n        WHERE event_id > {start_event_id}\n        ORDER BY event_id\n    \"\"\"\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        df = loader.load(query)\n\n    print(f'Ditemukan {len(df)} catatan hard delete sejak event_id {start_event_id}')\n    return df\n", "file_path": "data_loaders/extract_data_delete.py", "language": "python", "type": "data_loader", "uuid": "extract_data_delete"}, "data_loaders/get_data.py:data_loader:python:get data": {"content": "# pengambilan data baru atau terupdate per watermark\n\nfrom datetime import datetime, timedelta\nfrom os import path\n\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\nOVERLAP_MINUTES = 5          # mundur sedikit agar transaksi yang commit telat tetap terjaring\nMAX_ROWS_PER_RUN = 100_000   # pengaman memori, kalau terlampaui gunakan pipeline backfill\n\n\n@data_loader\ndef extract_articles(watermark, *args, **kwargs):\n    start_ts = datetime.fromisoformat(watermark['last_updated_at'])\n    if not watermark['is_first_run']:\n        start_ts -= timedelta(minutes=OVERLAP_MINUTES)\n\n    # Nilai di bawah berasal dari state kita sendiri (timestamp dan angka), bukan input pengguna\n    query = f\"\"\"\n        SELECT id, title, content, published_at, author_id,\n               created_at, updated_at, deleted_at\n        FROM public.articles\n        WHERE updated_at >= '{start_ts.isoformat()}'::timestamptz\n        ORDER BY updated_at, id\n        LIMIT {MAX_ROWS_PER_RUN + 1}\n    \"\"\"\n\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        df = loader.load(query)\n\n    if len(df) > MAX_ROWS_PER_RUN:\n        raise ValueError(\n            f'Baris yang berubah melebihi {MAX_ROWS_PER_RUN}. '\n            'Gunakan pipeline backfill per chunk, bukan pipeline incremental.'\n        )\n\n    print(f'Diambil {len(df)} baris sejak {start_ts.isoformat()}')\n    return df\n", "file_path": "data_loaders/get_data.py", "language": "python", "type": "data_loader", "uuid": "get_data"}, "data_loaders/generate_data.py:data_loader:python:generate data": {"content": "if 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\nif 'test' not in globals():\n    from mage_ai.data_preparation.decorators import test\n\n\n@data_loader\ndef load_data(*args, **kwargs):\n    \"\"\"\n    Template code for loading data from any source.\n\n    Returns:\n        Anything (e.g. data frame, dictionary, array, int, str, etc.)\n    \"\"\"\n    # Specify your data loading logic here\n\n    return {}\n\n\n@test\ndef test_output(output, *args) -> None:\n    \"\"\"\n    Template code for testing the output of the block.\n    \"\"\"\n    assert output is not None, 'The output is undefined'\n", "file_path": "data_loaders/generate_data.py", "language": "python", "type": "data_loader", "uuid": "generate_data"}, "data_loaders/generate_data_articles.py:data_loader:python:generate data articles": {"content": "-- =====================================================================\n-- berikut merupaka script pembuat data dummy untuk keperluan test project\n-- =====================================================================\n\nWITH base AS MATERIALIZED (\n    SELECT\n        n,\n        timestamptz '2016-01-01 00:00:00+00'\n          + random() * (now() - timestamptz '2016-01-01 00:00:00+00') AS created_at\n    FROM generate_series(1, 1000) AS n\n),\ndummy AS (\n    SELECT\n        n,\n        created_at,\n        CASE WHEN n % 5 = 0\n             THEN LEAST(created_at + (n % 30 + 1) * interval '1 day', now())\n             ELSE created_at\n        END AS updated_at\n    FROM base\n)\nINSERT INTO public.articles (title, content, published_at, author_id, created_at, updated_at, deleted_at)\nSELECT\n    'Judul artikel ' || n,\n    'Isi artikel dummy nomor ' || n || '. ' || repeat('Lorem ipsum dolor sit amet. ', 10),\n    created_at,\n    1 + floor(random() * 100)::bigint,\n    created_at,\n    updated_at,\n    CASE WHEN n % 20 = 0 THEN updated_at END\nFROM dummy\nWHERE NOT EXISTS (SELECT 1 FROM public.articles)\nORDER BY created_at;\n", "file_path": "data_loaders/generate_data_articles.py", "language": "python", "type": "data_loader", "uuid": "generate_data_articles"}, "data_loaders/get_watermark.py:data_loader:python:get watermark": {"content": "# Mengambil suatu watermark yang pada project ini berasal dari kolom last_update pada data warehouse sebagai patokan pengiriman data berkala di mulai dari titik mana\nfrom datetime import datetime, timezone\n\nfrom kumparan_etl.utils.warehouse import PIPELINE_NAME, get_clickhouse_client\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\nEPOCH = datetime(1970, 1, 1, tzinfo=timezone.utc)\n\n\n@data_loader\ndef get_watermark(*args, **kwargs):\n    client = get_clickhouse_client()\n    result = client.query(\n        'SELECT last_updated_at, last_id FROM etl_state FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE_NAME},\n    )\n\n    # Dikembalikan sebagai teks ISO agar aman diteruskan antar block Mage\n    if result.row_count == 0:\n        return {'last_updated_at': EPOCH.isoformat(), 'last_id': 0, 'is_first_run': True}\n\n    last_updated_at, last_id = result.first_row\n    return {\n        'last_updated_at': last_updated_at.isoformat(),\n        'last_id': int(last_id),\n        'is_first_run': False,\n    }\n", "file_path": "data_loaders/get_watermark.py", "language": "python", "type": "data_loader", "uuid": "get_watermark"}, "data_loaders/insert_simulation.sql:data_loader:sql:insert simulation": {"content": "-- Docs: https://docs.mage.ai/guides/sql-blocks\n\n-- simulasi penambahan data \n\nINSERT INTO public.articles (title, content, published_at, author_id)\nSELECT\n    'Artikel simulasi ' || to_char(now(), 'YYYY-MM-DD HH24:MI') || ' #' || g,\n    'Isi artikel simulasi. ' || repeat('Lorem ipsum dolor sit amet. ', 10),\n    now(),\n    1 + floor(random() * 100)::bigint\nFROM generate_series(1, 10) AS g;\n\n", "file_path": "data_loaders/insert_simulation.sql", "language": "sql", "type": "data_loader", "uuid": "insert_simulation"}, "data_loaders/get_delete_watermark.py:data_loader:python:get delete watermark": {"content": "# mencari watermark data terdelete\n\nfrom kumparan_etl.utils.warehouse import get_clickhouse_client\n\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\nPIPELINE = 'data_delete_handler'\n\n\n@data_loader\ndef get_delete_watermark(*args, **kwargs):\n    client = get_clickhouse_client()\n    result = client.query(\n        'SELECT last_id FROM etl_state FINAL WHERE pipeline = {p:String}',\n        parameters={'p': PIPELINE},\n    )\n    last_event_id = int(result.first_row[0]) if result.row_count else 0\n    return {'last_event_id': last_event_id}\n", "file_path": "data_loaders/get_delete_watermark.py", "language": "python", "type": "data_loader", "uuid": "get_delete_watermark"}, "data_loaders/generate_article_data.sql:data_loader:sql:generate article data": {"content": "-- ================================================================================================\n-- Script SQL yang berfungsi mengenerate data dummy dengan jumlah tertentu untuk keperluan project\n-- ================================================================================================\n\nWITH base AS MATERIALIZED (\n    SELECT\n        n,\n        timestamptz '2016-01-01 00:00:00+00'\n          + random() * (now() - timestamptz '2016-01-01 00:00:00+00') AS created_at\n    FROM generate_series(1, 1000) AS n\n),\ndummy AS (\n    SELECT\n        n,\n        created_at,\n        CASE WHEN n % 5 = 0\n             THEN LEAST(created_at + (n % 30 + 1) * interval '1 day', now())\n             ELSE created_at\n        END AS updated_at\n    FROM base\n)\nINSERT INTO public.articles (title, content, published_at, author_id, created_at, updated_at, deleted_at)\nSELECT\n    'Judul artikel ' || n,\n    'Isi artikel dummy nomor ' || n || '. ' || repeat('Lorem ipsum dolor sit amet. ', 10),\n    created_at,\n    1 + floor(random() * 100)::bigint,\n    created_at,\n    updated_at,\n    CASE WHEN n % 20 = 0 THEN updated_at END\nFROM dummy\nWHERE NOT EXISTS (SELECT 1 FROM public.articles)\nORDER BY created_at;\n\n", "file_path": "data_loaders/generate_article_data.sql", "language": "sql", "type": "data_loader", "uuid": "generate_article_data"}, "transformers/transform_data.py:transformer:python:transform data": {"content": "# Block: transform_articles | Type: Transformer (Python, Generic)\n# Tugas: standarisasi minimal. Data mentah tetap setia ke sumber.\nimport pandas as pd\n\nif 'transformer' not in globals():\n    from mage_ai.data_preparation.decorators import transformer\n\nDATETIME_COLUMNS = ['published_at', 'created_at', 'updated_at', 'deleted_at']\n\n\n@transformer\ndef transform_articles(df, *args, **kwargs):\n    if df.empty:\n        return df\n\n    df = df.copy()\n    for col in DATETIME_COLUMNS:\n        df[col] = pd.to_datetime(df[col], utc=True)   # semua timestamp seragam UTC\n\n    df['content'] = df['content'].fillna('')           # kolom String di ClickHouse tidak boleh NULL\n    return df\n", "file_path": "transformers/transform_data.py", "language": "python", "type": "transformer", "uuid": "transform_data"}, "pipelines/data_insert_simulation/metadata.yaml:pipeline:yaml:data insert simulation/metadata": {"content": "blocks:\n- all_upstream_blocks_executed: true\n  color: null\n  configuration:\n    data_provider: postgres\n    data_provider_profile: default\n    dbt: {}\n    disable_query_preprocessing: false\n    export_write_policy: append\n    limit: 1000\n    use_raw_sql: true\n  downstream_blocks: []\n  executor_config: null\n  executor_type: local_python\n  has_callback: false\n  language: sql\n  name: insert simulation\n  retry_config: null\n  status: executed\n  timeout: null\n  type: data_loader\n  upstream_blocks: []\n  uuid: insert_simulation\n- all_upstream_blocks_executed: true\n  color: null\n  configuration:\n    data_provider: postgres\n    data_provider_profile: default\n    dbt: {}\n    disable_query_preprocessing: false\n    export_write_policy: append\n    limit: 1000\n    use_raw_sql: true\n  downstream_blocks: []\n  executor_config: null\n  executor_type: local_python\n  has_callback: false\n  language: sql\n  name: update_simulation\n  retry_config: null\n  status: executed\n  timeout: null\n  type: data_loader\n  upstream_blocks: []\n  uuid: update_simulation\n- all_upstream_blocks_executed: true\n  color: null\n  configuration:\n    data_provider: postgres\n    data_provider_profile: default\n    dbt: {}\n    disable_query_preprocessing: false\n    export_write_policy: append\n    lim